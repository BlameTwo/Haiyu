<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Haiyu.Pages.Dialogs.ClearMemoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="using:Haiyu.Controls"
    xmlns:cui="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helper="using:Haiyu.Helpers"
    xmlns:local="using:Haiyu.Pages.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    CornerRadius="5"
    mc:Ignorable="d">
    <Grid Height="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition MaxHeight="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="内存清理" />
        <Button
            HorizontalAlignment="Right"
            Command="{x:Bind ViewModel.CloseCommand}"
            Style="{ThemeResource TransparentButtonStyle}" />
        <Grid Grid.Row="1">
            <control:StorageRing
                x:Name="ring"
                Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                MaxAngle="360"
                MinAngle="0"
                PercentCaution="75"
                PercentCritical="90"
                TrackRingThickness="10"
                ValueRingThickness="10"
                Value="100" />
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="30"
                Text="100%" />
        </Grid>
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Command="{x:Bind ViewModel.InvokeClearCommand}"
                Content="执行清理"
                Style="{ThemeResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</ContentDialog>
