<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:property="using:Haiyu.Controls.Propertys">
    <Style x:Key="LauncherButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorSuccess}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="property:LauncherButtonShine.IsEnabled" Value="True" />
        <Setter Property="property:LauncherButtonShine.PlayOnPointerOver" Value="True" />
        <Setter Property="property:LauncherButtonShine.PlayWhenEnabled" Value="True" />
    </Style>
</ResourceDictionary>
